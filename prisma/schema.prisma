generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Municipio {
  id         Int            @id @default(autoincrement())
  nome       String         @unique(map: "nome") @db.VarChar(200)
  imaId      Int?           @unique(map: "ima_id") @map("ima_id")
  estado     String?        @default("SC") @db.VarChar(2)
  createdAt  DateTime?      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt  DateTime?      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  historicos ImaHistorico[]

  @@map("municipios")
}

model ImaHistorico {
  id            Int       @id @default(autoincrement())
  municipioDbId Int?      @map("municipio_db_id")
  balneario     String    @db.VarChar(200)
  pontoColeta   String    @map("ponto_coleta") @db.VarChar(200)
  localizacao   String?   @db.VarChar(500)
  dataColeta    DateTime  @map("data_coleta") @db.Date
  hora          String?   @db.VarChar(10)
  vento         String?   @db.VarChar(50)
  mare          String?   @db.VarChar(50)
  chuva         String?   @db.VarChar(50)
  aguaTemp      String?   @map("agua_temp") @db.VarChar(20)
  arTemp        String?   @map("ar_temp") @db.VarChar(20)
  ecoli         String?   @db.VarChar(50)
  condicao      String?   @db.VarChar(50)
  anoReferencia Int       @default(2026) @map("ano_referencia")
  createdAt     DateTime? @default(now()) @map("created_at") @db.Timestamp(0)

  municipio Municipio? @relation(fields: [municipioDbId], references: [id])

  @@unique([municipioDbId, balneario, pontoColeta, dataColeta, hora], name: "uk_ponto_data", map: "uk_ponto_data")
  @@map("ima_historico")
}
